<system>
    <memory_region name="shared_mem" size="0x1000" page_size="0x1000" />

    <protection_domain name="pd_a" priority="100">
        <program_image path="pd_a.elf" />
        <map mr="shared_mem" vaddr="0x2000000" perms="rw" cached="true" />
    </protection_domain>

    <protection_domain name="pd_b" priority="100">
        <program_image path="pd_b.elf" />
        <map mr="shared_mem" vaddr="0x2000000" perms="rw" cached="true" />
    </protection_domain>
</system>
