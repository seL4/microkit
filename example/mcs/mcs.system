<system>
    <!-- moniter that control how the components run -->
    <protection_domain name="feudal_lord" priority="254">
        <program_image path="feudal_lord.elf" />

        <!-- tasks that require fast response to IRQ or notification, 1 sc -->
        <protection_domain name="fast_rt" priority="244" id="1">
            <program_image path="fast_rt.elf" />
        </protection_domain>

        <!-- critical tasks with hard deadlines, 1 sc -->
        <protection_domain name="hard_rt" priority="234" id="2">
            <program_image path="hard_rt.elf" />
        </protection_domain>

        <!-- soft deadlines, 1-3 sc -->
        <protection_domain name="soft_rt" priority="224" id="3">
            <program_image path="soft_rt.elf" />
        </protection_domain>

        <!-- best-effort tasks, as many as you wants (or maybe just 20-50 sc) -->

        <!-- 1 - 9 -->
        <protection_domain name="peasant_21" priority="99" budget="100_000" period="100_000"  id="21">
            <program_image path="peasant.elf" />
        </protection_domain>

